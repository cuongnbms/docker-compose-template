# GlitchTip secrets — copy to `.env` and fill with strong values.
#   cp .env.example .env
# Generate strong values, e.g.:
#   openssl rand -hex 24       # passwords (hex only: they are embedded in DATABASE_URL / VALKEY_URL)
#
# `.env` is gitignored — never commit real secrets.

# Public hostname, without scheme. Used for GLITCHTIP_DOMAIN (https://...) and the Traefik router rule.
GLITCHTIP_HOST=glitchtip.example.com

# PostgreSQL credentials. Also used to build GlitchTip's DATABASE_URL.
# NOTE: only applied on FIRST boot with an empty data directory.
POSTGRES_USER=glitchtip
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=glitchtip

# Valkey password. Valkey is on the shared traefik-net, so it must be protected.
VALKEY_PASSWORD=change-me-valkey-password

# Django secret key (sessions, tokens). Changing it logs everyone out.
#   openssl rand -hex 32
SECRET_KEY=change-me-secret-key
