# PostgreSQL connection (all required)
PG_HOST=devhost
PG_PORT=5432
PG_USER=dev
PG_PASSWORD=change-me
PG_SSLMODE=disable

# Optional: symmetric GPG passphrase. Leave empty to skip encryption.
# Without it, globals.sql (role password hashes) sits in plaintext in the archive.
ENCRYPT_KEY=

# Azure Blob Storage (required only when remote_backup.azure_blob_storage.enable is true)
ABS_ACCOUNT_NAME=
ABS_ACCESS_KEY=
ABS_CONTAINER=

# AWS S3 (required only when remote_backup.aws_s3.enable is true).
# Credentials come from the standard AWS chain, so leave the keys empty when the
# container runs on an EC2/ECS/EKS instance role.
S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# S3-compatible stores only (MinIO, Ceph, R2). Leave empty for real AWS.
S3_ENDPOINT=

# Notification webhooks. Set either, both, or neither. A channel is active when
# its URL is set; which events are sent is chosen by notify.events in config.yaml.
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# Label for this deployment, shown in every notification title. Set it when
# several servers post to the same channel: the title otherwise only carries
# PG_HOST:PG_PORT, which is often the same value on every one of them. Leave
# empty for a single server.
INSTANCE_NAME=
