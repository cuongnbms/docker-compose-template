# EMQX secrets — copy to `.env` and fill with strong values.
#   cp .env.example .env
# Generate strong values, e.g.:
#   openssl rand -hex 32       # cookie / JWT secret
#   openssl rand -base64 18    # passwords
#
# `.env` is gitignored — never commit real secrets.

# Erlang distribution cookie. Shared secret for cluster/node auth.
# Anyone with this can join the cluster and run code on the node.
EMQX_NODE_COOKIE=change-me-node-cookie

# Dashboard admin password (username defaults to `admin`).
# NOTE: only applied on FIRST boot with an empty data volume.
EMQX_DASHBOARD_PASSWORD=change-me-dashboard-password

# HMAC secret used to verify client JWTs. Must match your backend signing key.
EMQX_JWT_SECRET=change-me-jwt-secret
